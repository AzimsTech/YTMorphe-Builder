# YTMorphe dev variant configuration.
# Sourced by build.yml and the *.sh scripts (VARIANT=morphe).
# Keep the key list identical in variants/morphe-stable.env.

NAME=YTMorphe
BRAND=Morphe
TAG_SUFFIX=morphe

# Release channel: dev picks the newest release (prereleases included),
# stable picks the newest non-prerelease release.
RELEASE_CHANNEL=dev

# CLI
CLI_REPO=MorpheApp/morphe-desktop
CLI_JAR='morphe-*-all.jar'
CLI_JAR_REGEX='^(morphe-cli|morphe-desktop)-.*-all\.jar$'
CLI_VERSION_SED='s/^(morphe-cli|morphe-desktop)-(.+)-all\.jar$/\2/'

# Patches
PATCHES_SCRIPT=get-mpp.sh
PATCHES_GLOB='patches-*.mpp'
PATCH_FLAG=-p
PATCHES_REPO=MorpheApp/morphe-patches

# flags for `list-patches` (fetch-yt-ver.sh); LIST_EXTRA goes after --filter-package-name
LIST_FLAGS='--with-packages --with-versions --patches patches-*.mpp'
LIST_EXTRA='--include-experimental'

# Signing
KEYSTORE_NAME=yt-morphe-patched.keystore
KEYSTORE_GLOB='yt_*-patched.keystore'
